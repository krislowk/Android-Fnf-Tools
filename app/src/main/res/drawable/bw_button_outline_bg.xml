<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bw_panel" />
            <stroke android:width="2dp" android:color="@color/bw_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bw_black" />
            <stroke android:width="2dp" android:color="@color/bw_white" />
        </shape>
    </item>
</selector>
